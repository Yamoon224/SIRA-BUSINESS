# URL du backend Laravel (fallback en dur dans le code si absent)
NEXT_PUBLIC_BACKEND_URL=

# Paiements Kkiapay — clé PUBLIQUE uniquement (le widget s'ouvre côté client).
# Les clés privée/secrète restent côté backend (voir backend/.env).
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
NEXT_PUBLIC_KKIAPAY_SANDBOX=true

# Connexion Google — « Client ID » OAuth 2.0 (type application Web) créé dans
# Google Cloud Console sous support@goriya.net. Identique au GOOGLE_CLIENT_IDS
# du backend. Sans valeur, le bouton « Se connecter avec Google » est masqué.
# L'espace entreprise n'autorise Google que pour un compte entreprise existant.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
